generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum DocumentType {
  CV
  TRANSCRIPT
}

enum DocumentParseStatus {
  PENDING
  PARSED
  FAILED
}

enum DegreeLevel {
  bachelor
  master
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum EntitlementType {
  FULL_RESULTS_UNLOCK
}

enum EntitlementStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now())

  profile      Profile?
  documents    Document[]
  matchRuns    MatchRun[]
  purchases    Purchase[]
  entitlements Entitlement[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  mode            DegreeLevel
  personalJson    Json
  educationJson   Json
  testsJson       Json
  languagesJson   Json
  experiencesJson Json
  projectsJson    Json
  goalsJson       Json
  prefsJson       Json
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id            String              @id @default(cuid())
  userId        String
  type          DocumentType
  url           String
  extractedText String?
  parseStatus   DocumentParseStatus @default(PENDING)
  createdAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Program {
  id             String      @id @default(cuid())
  country        String
  degreeLevel    DegreeLevel
  universityName String
  programName    String
  language       String
  description    String?
  keywords       String?
  tuitionInfo    String?
  rankingQs      String?
  embedding      Unsupported("vector")?
  createdAt      DateTime    @default(now())

  results MatchResult[]

  @@unique([country, degreeLevel, universityName, programName, language], name: "program_uniq")
  @@index([country, degreeLevel])
  @@index([language])
}

model MatchRun {
  id                String   @id @default(cuid())
  userId            String
  profileId         String
  selectedCountries String[]
  selectedLanguages String[]
  requestedCount    Int
  createdAt         DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  results MatchResult[]
}

model MatchResult {
  id              String   @id @default(cuid())
  matchRunId      String
  programId       String
  similarityScore Float
  preScore        Float
  llmScore        Float
  finalScore      Float
  llmJson         Json

  matchRun MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([matchRunId, programId])
  @@index([matchRunId])
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  stripeSessionId String         @unique
  amount          Int
  currency        String
  status          PurchaseStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Entitlement {
  id        String           @id @default(cuid())
  userId    String
  type      EntitlementType
  status    EntitlementStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
}

