generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum DegreeLevel {
  BACHELOR
  MASTER
}

enum DocumentType {
  CV
  TRANSCRIPT
}

enum ParseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      Profile?
  documents    Document[]
  matchRuns    MatchRun[]
  purchases    Purchase[]
  entitlements Entitlement[]

  @@map("users")
}

model Profile {
  id        String      @id @default(cuid())
  userId    String      @unique
  mode      DegreeLevel
  
  // JSON fields for flexible data storage
  personalJson    Json?
  educationJson   Json?
  doubleMajorJson Json?
  testsJson       Json?
  experienceJson  Json?
  projectsJson    Json?
  goalsJson       Json?
  prefsJson       Json?
  
  // Selected countries and languages for matching
  selectedCountries String[]
  selectedLanguages String[]
  requestedCount    Int       @default(20)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchRuns MatchRun[]

  @@map("profiles")
}

model Document {
  id            String       @id @default(cuid())
  userId        String
  type          DocumentType
  filename      String
  url           String
  extractedText String?      @db.Text
  parseStatus   ParseStatus  @default(PENDING)
  parsedData    Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Program {
  id             String      @id @default(cuid())
  country        String
  degreeLevel    DegreeLevel
  universityName String
  programName    String
  language       String
  description    String?     @db.Text
  keywords       String[]
  tuitionInfo    String?
  rankingQs      Int?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  matchResults MatchResult[]

  @@unique([country, degreeLevel, universityName, programName, language])
  @@index([country, degreeLevel])
  @@index([language])
  @@map("programs")
}

model MatchRun {
  id                String   @id @default(cuid())
  userId            String
  profileId         String
  selectedCountries String[]
  selectedLanguages String[]
  requestedCount    Int
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  results MatchResult[]

  @@map("match_runs")
}

model MatchResult {
  id              String @id @default(cuid())
  matchRunId      String
  programId       String
  similarityScore Float
  preScore        Float
  llmScore        Float
  finalScore      Float
  llmJson         Json?
  rank            Int

  matchRun MatchRun @relation(fields: [matchRunId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([matchRunId, programId])
  @@map("match_results")
}

model Purchase {
  id              String         @id @default(cuid())
  userId          String
  stripeSessionId String         @unique
  stripePaymentId String?
  amount          Int
  currency        String         @default("usd")
  status          PurchaseStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  type      String
  status    EntitlementStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime          @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}
